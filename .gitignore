# `lib/` is deliberately NOT ignored: users install the prebuilt package and
# should not need esbuild on their own machine. Run `node scripts/build.mjs`
# after touching `src/`, and commit the result.

node_modules/
*.log

# No credentials ever belong in this repo; the guard is here so a future
# mistake is caught by `git status` rather than by a public push.
.env
.env.*
*.pem
*.key

.DS_Store
Thumbs.db

# Scratch: live-check output, harness downloads (React UMD), snapshots,
# screenshots from the real-browser pass, and the local `pnpm pack` tarball
# (the GitHub release asset is the distribution channel, not a committed file).
_tmp/
_tmp_*/
.*.tmp
*.tgz
